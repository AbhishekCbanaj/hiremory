# Copy to worker/.env and fill in to run the worker locally.
# (In GitHub Actions these are set as repo Secrets — see .github/workflows/worker.yml)

SUPABASE_URL=https://maxoqzfeqefvegapmnwf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...        # Supabase -> Settings -> API -> service_role

# Encrypts SMTP/IMAP app passwords. MUST be identical in web/.env.local.
# Generate once:  openssl rand -base64 32
MAILBOX_ENC_KEY=

# Only needed for Gmail-OAuth senders (the one-click Google flow):
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- optional, for safe local testing ---
DRY_RUN=1                 # log only, send nothing
SEND_SPACING_SECONDS=5    # speed up between sends while testing (prod: 45)
MAX_SENDS_PER_RUN=3       # hard cap so a test run can't blast the whole list
APP_BASE_URL=http://localhost:3000
SENTRY_DSN=          # optional: free Sentry error reporting

# Optional AI layer (Phase 4) — COSTS MONEY per email. Omit to use free templates.
ANTHROPIC_API_KEY=          # sk-ant-...  enables Claude personalization + reply intent
ANTHROPIC_MODEL=            # default claude-opus-4-8; set claude-haiku-4-5 to cut cost ~80%
