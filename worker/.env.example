# Hiremory — worker environment
# Copy to .env and fill in. NEVER commit .env (it's git-ignored).
# See docs/configuration.md for details.

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Mailbox encryption (required) ---
# MUST be identical to web/.env.local's MAILBOX_ENC_KEY, or decryption fails.
MAILBOX_ENC_KEY=your-base64-32-byte-key

# --- App URL (required — used to build unsubscribe links) ---
APP_BASE_URL=http://localhost:3000

# --- AI (optional — falls back to a template without a key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# --- Ops (optional) ---
SENTRY_DSN=
DRY_RUN=          # set to 1 to log actions without sending
