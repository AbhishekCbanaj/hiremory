# Hiremory — web app environment
# Copy to .env.local and fill in. NEVER commit .env.local (it's git-ignored).
# See docs/configuration.md for details.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only — never expose client-side

# --- Mailbox encryption (required) ---
# 32-byte base64 key. MUST match worker/.env. Generate with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MAILBOX_ENC_KEY=your-base64-32-byte-key

# --- AI (optional — without a key, Hiremory falls back to a template) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=            # optional paid fallback

# --- Billing (optional — leave blank to run Free-only) ---
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_LINK=
