# Copy to .env.local and fill from your Supabase project
# (Project Settings -> API). NEXT_PUBLIC_* values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. NEVER prefix with NEXT_PUBLIC. Used by the worker / server routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 6 billing (optional)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_LINK=
