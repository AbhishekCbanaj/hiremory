# Hiremory — web app environment
# Copy to .env.local and fill in. NEVER commit .env.local (it's git-ignored).
# See docs/configuration.md for details.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only — never expose client-side

# --- Mailbox encryption (required) ---
# 32-byte base64 key. MUST match worker/.env. Generate with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MAILBOX_ENC_KEY=your-base64-32-byte-key

# --- AI (optional — without a key, Hiremory falls back to a static template) ---
# Precedence: AI_API_KEY (Grok/OpenAI-compatible) → GEMINI_API_KEY → ANTHROPIC_API_KEY
# Grok:   AI_BASE_URL=https://api.x.ai/v1        AI_MODEL=grok-3
# OpenAI: AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=            # optional paid fallback

# --- Billing (optional — leave blank to run Free-only) ---
# Stripe (international / USD)
STRIPE_SECRET_KEY=            # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (endpoint: /api/billing/webhook)
STRIPE_PRICE_PRO=             # recurring price_... (Pro subscription)
STRIPE_PRICE_TOPUP=           # one-time price_... (credit pack)
# Razorpay (India / INR)
RAZORPAY_KEY_ID=              # rzp_test_... / rzp_live_...
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO=            # plan_... (Pro subscription plan)
RAZORPAY_WEBHOOK_SECRET=      # endpoint: /api/billing/razorpay/webhook
